# Copier en .env a la racine (le fichier .env est ignore par git).

# --- Serveur Rust ---------------------------------------------------------
DATABASE_URL=postgres://postgres:belote_dev@localhost:5432/belote
# Au moins 32 caracteres. En production : une valeur aleatoire, jamais celle-ci.
JWT_SECRET=changez-moi-en-production-32-caracteres-minimum
ALLOWED_ORIGIN=http://localhost:3000
PORT=8080

# En local on sert en http : le cookie ne peut pas etre Secure.
SECURE_COOKIES=false
# En production, avec un domaine parent commun au front et a l'API :
# COOKIE_DOMAIN=.tondomaine.fr

# --- Front Next.js --------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
